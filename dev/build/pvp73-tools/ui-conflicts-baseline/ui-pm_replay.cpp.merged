        case 2: return V::func([sp](const Args& A) { return sp->m__inputs(A); });
        case 3: return V::func([sp](const Args& A) { return sp->m_seek(A); });
        case 4: return V::func([sp](const Args& A) { return sp->m_update(A); });
        case 5: return V::func([sp](const Args& A) { return sp->m_close(A); });
    }
    return V();
}
