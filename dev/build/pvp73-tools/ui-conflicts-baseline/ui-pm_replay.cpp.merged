V cls_Playback() { static V c = [] { V c = py::class_value(SV("Playback"), [](const Args& A) { return new_Playback(A); }); return c; }(); return c; }
static bool inited_ = false;
void init() {
    if (inited_) return;
    inited_ = true;
    py::note_module_loaded("pvp.replay");
    py::init_deps_replay();
    pm_replay::FORMAT = SV("pvz-pvp-replay-1");
    pm_replay::MAX_BYTES = ((V(64.0) * V(1024.0)) * V(1024.0));
    pm_replay::SPEEDS = V::tuple({V(0.25), V(0.5), V(1.0), V(2.0), V(4.0), V(8.0)});
    pm_replay::INPUT_FIELDS = V::tuple({SV("type"), SV("seq"), SV("move"), SV("jump"), SV("edge"), SV("card"), SV("x"), SV("y"), SV("facing"), SV("grave"), SV("copy"), SV("resource"), SV("right"), SV("target"), SV("clear"), SV("request")});
}
static V modattr_(Sym n) {
    init();
    const std::string& s = n.str();
    if (s == "FORMAT") return pm_replay::FORMAT;
    if (s == "MAX_BYTES") return pm_replay::MAX_BYTES;
    if (s == "SPEEDS") return pm_replay::SPEEDS;
    if (s == "INPUT_FIELDS") return pm_replay::INPUT_FIELDS;
    if (s == "state_hash") return V::func(f_state_hash);
    if (s == "matches_state_hash") return V::func(f_matches_state_hash);
    if (s == "read_recording") return V::func(f_read_recording);
    if (s == "Recording") return cls_Recording();
    if (s == "Playback") return cls_Playback();
    if (s == "AuditLog") return pm_audit_log::cls_AuditLog();
    if (s == "BUILD") return py::data_value("__init__", "BUILD");
    if (s == "NativeBattle") return pm_native_battle::cls_NativeBattle();
    if (s == "Path") return py::stdlib(SV("pathlib.Path"));
    if (s == "ROOM_TICK_RATES") return pm_catalog::ROOM_TICK_RATES;
    if (s == "RULES") return pm_catalog::RULES;
    if (s == "catalog_hash") return V::func(pm_catalog::f_catalog_hash);
    if (s == "copy") return py::stdlib(SV("copy"));
    if (s == "digest") return V::func(pm_catalog::f_digest);
    if (s == "json") return py::stdlib(SV("json"));
    if (s == "os") return py::stdlib(SV("os"));
    if (s == "rules_hash") return V::func(pm_catalog::f_rules_hash);
    if (s == "tempfile") return py::stdlib(SV("tempfile"));
    if (s == "time") return py::stdlib(SV("time"));
    if (s == "uuid") return py::stdlib(SV("uuid"));
    if (s == "write_json_array") return V::func(pm_audit_log::f_write_json_array);
    return V();
}
V module_ns() { static const bool reg_ = (py::register_module_attrs("replay", modattr_), true); (void)reg_; init(); return py::module_ns(SV("replay")); }
