}

V f_page_summary(const Args& A) {
    V L_player = A.get(0, SY("player"), nullptr, "page_summary");
    V L_battle_time = A.get(1, SY("battle_time"), nullptr, "page_summary");
    V L_deathmatch = A.get(2, SY("deathmatch"), nullptr, "page_summary");
    V L_page = A.get(3, SY("page"), nullptr, "page_summary");
    V L_capacity = (A.size() > 4 || A.has_kw(SY("capacity"))) ? A.get(4, SY("capacity"), nullptr) : V(V(8.0));
    V L_blocked;
    V L_c;
    V L_cd;
    V L_hidden;
    V L_key;
    V L_keys;
    V L_next_cd;
    V L_pages;
    V L_ready;
    V L_text;
    L_keys = [&]() -> V { V out_ = V::list(); V L_key; { V it1_ = py::iter_list(py::m_get(L_player, SV("deck"), V::list({}))); for (size_t i1_ = 0; i1_ < it1_.len(); ++i1_) { L_key = it1_.idx(int64_t(i1_)); if (!((rd(rd(pm_catalog::CARDS, L_key), SV("category")) != SV("secret")))) continue; out_.append(L_key); }}return out_; }();
    L_pages = py::max_it(V::list({V(1.0), V(std::ceil(((py::len(L_keys) / L_capacity)).num()))}), py::Key(), V());
    L_page = (L_page % L_pages);
    L_hidden = (py::slice(L_keys, V::none(), (L_page * L_capacity)) + py::slice(L_keys, ((L_page + V(1.0)) * L_capacity), V::none()));
    L_ready = V(0.0);
    L_next_cd = V::list({});
    L_blocked = V(0.0);
