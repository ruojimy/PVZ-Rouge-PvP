V f_opponent_idle_text(const Args& A) {
    V L_view = A.get(0, SY("view"), nullptr, "opponent_idle_text");
    V L_local = A.get(1, SY("local"), nullptr, "opponent_idle_text");
    V L_threshold = (A.size() > 2 || A.has_kw(SY("threshold"))) ? A.get(2, SY("threshold"), nullptr) : V(V(1.5));
    V L_grace = (A.size() > 3 || A.has_kw(SY("grace"))) ? A.get(3, SY("grace"), nullptr) : V(V(3.0));
    V L_battle;
    V L_dormant;
    V L_idle;
    V L_last;
    V L_parts;
    V L_player;
    V L_rate;
    V L_scripted;
    V L_side;
    V L_team_of;
    V L_tick;
    L_battle = py_or(py::m_get(L_view, SV("battle")), [&]() -> V { return py_dict({}); });
    L_tick = py::m_get(L_battle, SV("tick"));
    L_rate = py_or(py::m_get(py_or(py::m_get(L_view, SV("rules")), [&]() -> V { return py_dict({}); }), SV("tick_rate"), V(30.0)), [&]() -> V { return V(30.0); });
    if ((!(V((isinstance(L_tick, "int")))).truthy() || (py::m_get(L_battle, SV("time"), V(0.0)) < L_grace))) {
        return SV("");
    }
    if (((py::m_get(L_view, SV("paused"))).truthy() || (py::m_get(L_battle, SV("result"))).truthy() || (py::m_get(L_view, SV("result"))).truthy())) {
        return SV("");
    }
    L_parts = V::list({});
    L_scripted = V::func(pm_teams::f_scripted);
    L_team_of = V::func(pm_teams::f_team_of);
    L_dormant = (L_scripted).call(Args{py_or(py::m_get(L_view, SV("mode")), [&]() -> V { return py_or(py::m_get(L_battle, SV("mode")), [&]() -> V { return SV("duel"); }); })});
    { auto it1_ = py::items_vec(py_or(py::m_get(L_battle, SV("players")), [&]() -> V { return py_dict({}); }));
    for (size_t i1_ = 0; i1_ < it1_.size(); ++i1_) {
        L_side = it1_[i1_].first; L_player = it1_[i1_].second; 
        if (py::in(L_side, L_local)) {
            continue;
        }
        if (((L_dormant).truthy() && ((L_team_of).call(Args{L_side}) == SV("zombie")))) {
            continue;
        }
        if ((py::m_get(L_player, SV("absent"))).truthy()) {
