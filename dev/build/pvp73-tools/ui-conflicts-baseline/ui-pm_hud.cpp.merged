    if ((py::m_get(L_hero, SV("collect_locked_until"), V(0.0)) > L_now)) {
        (void)(py::m_append(L_labels, py::percent(SV("鼠标拾阳光 %.1fs"), (rd(L_hero, SV("collect_locked_until")) - L_now))));
    }
    return callm(SV(" · "), SY("join"), Args{L_labels});
    return V::none();
}

bool C_FeedbackTracker::isa(const char* c) const { std::string s(c); return s == "FeedbackTracker" || s == "object"; }
V* C_FeedbackTracker::slot(Sym name) {
    static const SymIndex idx_({SY("key"), SY("tick"), SY("losses"), SY("notice"), SY("until")});
    const int k_ = idx_.find(name);
    if (k_ < 0) return nullptr;
    switch (k_) {
        case 0: return &a_key;
        case 1: return &a_tick;
        case 2: return &a_losses;
        case 3: return &a_notice;
        case 4: return &a_until;
    }
    return nullptr;
}
V C_FeedbackTracker::method(Sym name) {
    static const SymIndex idx_({SY("__init__"), SY("update")});
    const int k_ = idx_.find(name);
    if (k_ < 0) return V();
    auto sp = std::static_pointer_cast<C_FeedbackTracker>(shared_from_this());
    switch (k_) {
        case 0: return V::func([sp](const Args& A) { return sp->m___init__(A); });
        case 1: return V::func([sp](const Args& A) { return sp->m_update(A); });
    }
    return V();
}
bool C_FeedbackTracker::call_method(Sym name, const Args& A, V& out) {
    static const SymIndex idx_({SY("__init__"), SY("update")});
    const int k_ = idx_.find(name);
    if (k_ < 0) return false;
    switch (k_) {
        case 0: out = m___init__(A); return true;
        case 1: out = m_update(A); return true;
    }
    return false;
}
V C_FeedbackTracker::m___init__(const Args& A) {
    a_key = V::none();
    a_tick = V(-1.0);
    a_losses = py_dict({});
    a_notice = SV("");
    a_until = V(0.0);
    return V::none();
}

V C_FeedbackTracker::m_update(const Args& A) {
    V L_view = A.get(0, SY("view"), nullptr, "update");
    V L_side = A.get(1, SY("side"), nullptr, "update");
    V L_battle;
    V L_damaged;
    V L_delta;
    V L_graves;
    V L_key;
    V L_lost;
    V L_now;
    V L_status;
    V L_text;
    V L_units;
    L_battle = py_or(py::m_get(L_view, SV("battle")), [&]() -> V { return py_dict({}); });
    L_now = py::m_get(L_battle, SV("time"), V(0.0));
    L_key = V::tuple({py::m_get(L_view, SV("match_number")), py::m_get(L_view, SV("terrain_hash")), L_side});
    L_lost = py::m_get(py::m_get(py::m_get(py::m_get(L_battle, SV("players"), py_dict({})), L_side, py_dict({})), SV("stats"), py_dict({})), SV("producer_lost"), V(0.0));
    if (((L_key != a_key) || (py::m_get(L_battle, SV("tick"), V(0.0)) < a_tick))) {
        a_key = L_key;
        a_losses = py_dict({{L_side, L_lost}});
        a_notice = SV("");
        a_until = V(0.0);
    }
    L_delta = (L_lost - py::m_get(a_losses, L_side, L_lost));
    if ((L_delta > V(0.0))) {
        a_notice = (((L_side == SV("zombie")) ? V(SV("本批损失 %d 座经济墓碑")) : V(SV("本批损失 %d 个生产者"))) % L_delta);
        a_until = (L_now + V(4.0));
    }
    pvz::setitem(a_losses, L_side, L_lost);
    a_tick = py::m_get(L_battle, SV("tick"), V(0.0));
    L_units = py::m_get(L_battle, SV("units"), V::list({}));
    L_units = ((V((isinstance(L_units, "dict")))).truthy() ? V(callm(L_units, SY("values"), Args{})) : V(L_units));
    L_graves = [&]() -> V { V out_ = V::list(); V L_u; { V it1_ = py::iter_list(L_units); for (size_t i1_ = 0; i1_ < it1_.len(); ++i1_) { L_u = it1_.idx(int64_t(i1_)); if (!(((py::m_get(L_u, SV("behavior")) == SV("grave")) && (py::m_get(L_u, SV("side")) == SV("zombie")) && (py::m_get(L_u, SV("hp"), V(0.0)) > V(0.0))))) continue; out_.append(L_u); }}return out_; }();
    L_damaged = py::sum_it([&]() -> V { V out_ = V::list(); V L_u; { V it2_ = py::iter_list(L_graves); for (size_t i2_ = 0; i2_ < it2_.len(); ++i2_) { L_u = it2_.idx(int64_t(i2_)); out_.append(V((rd(L_u, SV("hp")) < py::m_get(L_u, SV("max_hp"), rd(L_u, SV("hp")))))); }}return out_; }());
    L_text = ((L_now < a_until) ? V(a_notice) : V(SV("")));
    if ((L_side == SV("zombie"))) {
        L_status = py::percent(SV("出兵点 %d"), py::len(L_graves));
        if ((L_damaged).truthy()) {
            L_status = py::iadd(L_status, py::percent(SV(" · %d 座墓碑受损"), L_damaged));
        }
        if (!(L_graves).truthy()) {
            L_status = py::iadd(L_status, SV(" · 无可用墓碑"));
        }
        L_text = (L_status + ((L_text).truthy() ? V((SV(" / ") + L_text)) : V(SV(""))));
    }
    return L_text;
    return V::none();
}

void initcv_FeedbackTracker(C_FeedbackTracker* p) {

}
V new_FeedbackTracker(const Args& A) {
    init();
    auto p = std::make_shared<C_FeedbackTracker>();
    V self = V::inst(p);
    initcv_FeedbackTracker(p.get());
    p->m___init__(A);
    return self;
}
V cls_FeedbackTracker() { static V c = [] { V c = py::class_value(SV("FeedbackTracker"), [](const Args& A) { return new_FeedbackTracker(A); }); return c; }(); return c; }
static bool inited_ = false;
void init() {
    if (inited_) return;
    inited_ = true;
    py::note_module_loaded("pvp.hud");
    py::init_deps_hud();
    pm_hud::INPUT_BLOCK_TEXT = py_dict({{SV("unfocused"), SV("窗口不在前台 · 按键没有发送")}, {SV("viewing"), SV("正在查看菜单 / 图鉴 · 你的操作已暂停")}, {SV("textbox"), SV("搜索框占用键盘 · 你的操作已暂停")}, {SV("leaving"), SV("离开确认框打开中 · 你的操作已暂停")}, {SV("audit"), SV("日志写入失败 · 对局已暂停")}});
    pm_hud::SIDE_NAMES = py_dict({{SV("plant"), SV("植物方")}, {SV("zombie"), SV("僵尸方")}});
}
static V modattr_(Sym n) {
    init();
    const std::string& s = n.str();
    if (s == "INPUT_BLOCK_TEXT") return pm_hud::INPUT_BLOCK_TEXT;
    if (s == "SIDE_NAMES") return pm_hud::SIDE_NAMES;
    if (s == "bank_page_size") return V::func(f_bank_page_size);
    if (s == "battle_deck") return V::func(f_battle_deck);
    if (s == "battle_card") return V::func(f_battle_card);
    if (s == "latency_text") return V::func(f_latency_text);
    if (s == "cooperation_hint") return V::func(f_cooperation_hint);
    if (s == "input_block_text") return V::func(f_input_block_text);
    if (s == "opponent_idle_text") return V::func(f_opponent_idle_text);
    if (s == "page_summary") return V::func(f_page_summary);
    if (s == "stage_text") return V::func(f_stage_text);
    if (s == "hero_status") return V::func(f_hero_status);
    if (s == "FeedbackTracker") return cls_FeedbackTracker();
    if (s == "CARDS") return pm_catalog::CARDS;
    if (s == "actual_card") return V::func(pm_catalog::f_actual_card);
    if (s == "deathmatch_blocked") return V::func(pm_balance::f_deathmatch_blocked);
    if (s == "math") return py::stdlib(SV("math"));
    return V();
}
V module_ns() { static const bool reg_ = (py::register_module_attrs("hud", modattr_), true); (void)reg_; init(); return py::module_ns(SV("hud")); }
}}  // namespace pvz::pm_hud
