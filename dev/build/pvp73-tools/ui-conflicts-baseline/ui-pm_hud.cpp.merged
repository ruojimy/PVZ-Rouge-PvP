    for (size_t i2_ = 0; i2_ < it2_.len(); ++i2_) {
        L_key = it2_.idx(int64_t(i2_)); 
        L_c = pm_catalog::f_actual_card(Args{L_key, py::m_get(L_player, SV("secrets"), V::tuple({}))});
        if (((L_deathmatch).truthy() && (pm_balance::f_deathmatch_blocked(Args{L_c})).truthy())) {
            L_blocked = py::iadd(L_blocked, V(1.0));
            continue;
        }
        L_cd = py::max_it(V::list({V(0.0), (py::m_get(py::m_get(L_player, SV("cooldowns"), py_dict({})), L_key, V(0.0)) - L_battle_time)}), py::Key(), V());
        if ((L_cd).truthy()) {
            (void)(py::m_append(L_next_cd, L_cd));
        } else if ((py::m_get(L_player, SV("resource"), V(0.0)) >= rd(L_c, SV("cost")))) {
            L_ready = py::iadd(L_ready, V(1.0));
        }
    }}
    L_text = ((L_hidden).truthy() ? V(py::percent(SV("其他页：%d 张可用"), L_ready)) : V(SV("本页已显示全部部署卡")));
    if ((L_next_cd).truthy()) {
        L_text = py::iadd(L_text, py::percent(SV(" · 最近 %.1fs"), py::min_it(L_next_cd, py::Key(), V())));
    }
    if ((L_blocked).truthy()) {
        L_text = py::iadd(L_text, py::percent(SV(" · %d 张禁新生产"), L_blocked));
    }
    return py_dict({{SV("text"), L_text}, {SV("hidden"), L_hidden}, {SV("ready"), L_ready}, {SV("next_cd"), ((L_next_cd).truthy() ? V(py::min_it(L_next_cd, py::Key(), V())) : V(V::none()))}, {SV("blocked"), L_blocked}});
    return V::none();
}

V f_stage_text(const Args& A) {
    V L_battle = A.get(0, SY("battle"), nullptr, "stage_text");
    V L_rules = A.get(1, SY("rules"), nullptr, "stage_text");
    V L_now;
    V L_threshold;
    V L_wave_line;
    V L_waves;
    L_now = py::m_get(L_battle, SV("time"), V(0.0));
    L_threshold = py::m_get(L_rules, SV("deathmatch_seconds"), V(420.0));
    L_waves = py::m_get(py_or(py::m_get(L_battle, SV("team")), [&]() -> V { return py_dict({}); }), SV("waves"));
    if ((L_waves).truthy()) {
        L_wave_line = V::func(pm_team_hud::f_wave_line);
        return (L_wave_line).call(Args{py::m_get(L_battle, SV("team"))});
    }
    if ((L_threshold >= V(100000000.0))) {
        return SV("生产者持续有效");
    }
    if ((py::m_get(L_battle, SV("deathmatch"))).truthy()) {
        return py::percent(SV("死斗：禁止新增生产者 · 已有生产 ×%g · 水中英雄每秒-1生命"), py::m_get(L_rules, SV("production_multiplier"), V(1.5)));
    }
    if ((L_now >= (L_threshold - V(30.0)))) {
        return py::percent(SV("%d 秒后禁止新生产者 · 已有生产将提速"), py::max_it(V::list({V(0.0), V(std::ceil(((L_threshold - L_now)).num()))}), py::Key(), V()));
    }
    return py::percent(SV("距死斗 %02d:%02d · 届时禁止新增生产者"), V::tuple({floordiv(py::int_((L_threshold - L_now)), V(60.0)), (py::int_((L_threshold - L_now)) % V(60.0))}));
    return V::none();
}

