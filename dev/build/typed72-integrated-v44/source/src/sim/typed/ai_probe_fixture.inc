using J=nlohmann::ordered_json;
bool json_truth(const J& value){if(value.is_null())return false;if(value.is_boolean())return value.get<bool>();if(value.is_number())return value.get<double>()!=0.;if(value.is_string())return !value.get_ref<const std::string&>().empty();return !value.empty();}
template<class T>std::optional<T> optional_value(const J& value,const char* key){const auto it=value.find(key);return it==value.end()||it->is_null()?std::nullopt:std::optional<T>(it->get<T>());}
Seat faction(const J& value){return value=="plant"?Seat::plant:Seat::zombie;}
Seat seat_value(const J& value){if(value=="plant")return Seat::plant;if(value=="plant2")return Seat::plant2;if(value=="zombie2")return Seat::zombie2;return Seat::zombie;}
std::string fixture_seat_name(Seat s){return std::string(pvz::typed72::seat_name(s));}
Point point(const J& value){return {value.value("x",0.),value.value("y",0.)};}
AiPublicHero public_hero(const J& v){AiPublicHero h;h.position=point(v);h.velocity={v.value("vx",0.),v.value("vy",0.)};h.w=v.value("w",38.);h.h=v.value("h",91.);h.hp=v.value("hp",0.);h.max_hp=v.value("max_hp",1.);h.resource=v.value("resource",0.);h.teleport_ready=v.value("teleport_ready_at",0.);h.facing=v.value("facing",int64_t(1));h.jump_cap=v.value("jump_cap",int64_t(2));h.jumps=v.value("jumps",int64_t(0));h.poison=v.value("poison_level",int64_t(0));h.grounded=v.value("grounded",false);h.frozen=v.value("frozen",false);h.slowed=v.value("slowed",false);h.buttered=v.value("buttered",false);h.absent=v.value("absent",false);h.cannon_aimed=v.contains("cannon_aim")&&json_truth(v["cannon_aim"]);return h;}
AiUnitView public_unit(const J& v){AiUnitView u;u.id=v.value("id",std::string{});u.card=v.value("card_id",std::string{});u.side=faction(v.value("side",J{}));if(v.contains("seat"))u.seat=seat_value(v["seat"]);u.position=point(v);u.hp=v.value("hp",0.);u.max_hp=v.value("max_hp",1.);u.velocity={v.value("vx",0.),v.value("vy",0.)};u.mobile=v.value("mobile",false);u.awake=v.value("awake",true);u.behavior=optional_value<std::string>(v,"behavior");u.grave=u.behavior=="grave";const auto c=v.value("card",J::object());u.card_info.name=optional_value<std::string>(c,"name");u.card_info.behavior=c.value("behavior",std::string{});u.card_info.cost=optional_value<double>(c,"cost");u.card_info.range=optional_value<double>(c,"range");u.card_info.damage=c.value("damage",0.);u.card_info.producer=c.value("producer",false);u.card_info.mushroom=c.value("mushroom",false);return u;}
std::vector<AiUnitView> public_units(const J& values){std::vector<AiUnitView> out;for(const auto& v:values)out.push_back(public_unit(v));return out;}
AiVisibleShot public_shot(const J& v){AiVisibleShot s;s.id=v.value("id",std::string{});s.asset=v.value("asset",std::string{});if(s.asset.empty())s.asset=v.value("kind",std::string{});s.side=faction(v.value("side",J{}));s.position=point(v);s.velocity={v.value("vx",0.),v.value("vy",0.)};s.gravity=v.value("gravity",0.);s.damage=v.value("damage",0.);s.slow=v.value("slow",false);s.control=v.value("control",false);s.splash=v.value("splash",0.);return s;}
J support_decision(const std::optional<AiSupportDecision>& v){if(!v)return nullptr;J out{{"state",ai_support_state_name(v->state)},{"reason",ai_support_reason_name(v->reason)},{"post",v->post},{"reserve",v->reserve}};if(v->mate){out["mate"]=fixture_seat_name(*v->mate);out["mate_x"]=v->mate_position.x;out["mate_y"]=v->mate_position.y;}return out;}
